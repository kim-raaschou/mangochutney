# what the overview refuses: floating, minimize, scratchpads, groups, resize, tag changes; and an empty monitor.
config new_is_master=0
dispatch toggleoverview
check
open a
open b
dispatch toggleoverview
dispatch togglefloating
dispatch minimized
dispatch toggle_scratchpad
dispatch groupjoin,left
dispatch resizewin,+100,+0
dispatch toggletag,2
dispatch toggleview,2
dispatch set_proportion,0.5
check
dispatch toggleoverview
check
