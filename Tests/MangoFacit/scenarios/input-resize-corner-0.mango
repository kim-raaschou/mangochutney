# drag_corner=0 without drag_warp_cursor: the top left corner follows the pointer and the bottom right stays.
config mousebind=NONE,btn_right,moveresize,curresize
config drag_corner=0
config drag_warp_cursor=0
open a
dispatch togglefloating
check
pointer 1264,744
button right down
check
move -50,-30
check
button right up
check
