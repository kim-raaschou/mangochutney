# a click on a group bar's segment focuses that member: three segments share the bar's width side by side, the first takes the remainder.
config new_is_master=0
open a
open b
open c
dispatch groupjoin,up
dispatch focusdir,left
dispatch groupjoin,right
check
pointer 644,25
click left
check
pointer 1277,25
click left
check
pointer 1276,25
click left
check
pointer 643,25
click left
check
