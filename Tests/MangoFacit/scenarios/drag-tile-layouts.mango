# where a dragged tile lands: vertical_tile's stack by left and right half, grid by the nearest edge.
config new_is_master=0
config mousebind=NONE,btn_middle,moveresize,curmove
dispatch setlayout,vertical_tile
open a
open b
open c
check
pointer 500,800
button middle down
pointer 1800,800
button middle up
check
pointer 1440,800
button middle down
pointer 100,800
button middle up
check
dispatch setlayout,grid
check
pointer 500,500
button middle down
pointer 30,300
check
button middle up
check
pointer 500,500
button middle down
pointer 1000,1050
check
button middle up
check
