# mmsg get in the states a client and a tag can be in: a group, the scratchpad, urgent, the overview,
# fullscreen and global.
# ours: tile gives the last window of a column the rest of it (a mango bug, docs/afvigelser.md §6).
config focus_on_activate=0
open a
open b
open c
open d
dispatch groupjoin,down
get all-clients
ours clients.3.height 351
get focusing-client
get client @c
dispatch @a minimized
get client @a
ours height 351
get all-tags
dispatch @b togglefullscreen
get client @b
dispatch @b toggleglobal
get monitor HEADLESS-1
dispatch toggleoverview
get all-tags
get monitor HEADLESS-1
get focusing-client
dispatch toggleoverview
dispatch setlayout,scroller
get all-tags
get layouts
check
ours a.height 351
