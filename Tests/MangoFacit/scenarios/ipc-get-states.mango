# mmsg get in the states a client and a tag can be in: a group, the scratchpad, urgent, the overview,
# fullscreen and global.
config focus_on_activate=0
open a
open b
open c
open d
dispatch groupjoin,down
get all-clients
get focusing-client
get client @c
dispatch @a minimized
get client @a
get all-tags
dispatch @b togglefullscreen
get client @b
dispatch @b toggleglobal
get monitor HEADLESS-1
dispatch toggleoverview
get all-tags
get monitor HEADLESS-1
get focusing-client
dispatch toggleoverview
dispatch setlayout,scroller
get all-tags
get layouts
check
