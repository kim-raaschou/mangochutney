open b
open c
dispatch overcircle,next
check
dispatch overcircle,next
check
dispatch overcircle,prev
dispatch overcircle,prev
check
dispatch toggleoverview
check
dispatch view,2
open d
dispatch overcircle,current_next
check
dispatch leaveoverview
check
