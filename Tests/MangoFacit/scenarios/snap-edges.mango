# enable_floating_snap: a floating window let go within snap_distance of the monitor's edges snaps to them; at the distance or further it stays.
config enable_floating_snap=1
config mousebind=NONE,btn_middle,moveresize,curmove
open a
dispatch togglefloating
check
pointer 960,540
button middle down
pointer 424,327
