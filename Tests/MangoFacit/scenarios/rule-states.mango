# window_rule: is_global, is_overlay, is_fullscreen, is_fake_fullscreen, no_border.
config new_is_master=0
config window_rule=app_id:b,is_fullscreen:1
config window_rule=app_id:c,is_global:1
config window_rule=app_id:d,is_overlay:1
config window_rule=app_id:e,is_fake_fullscreen:1
config window_rule=app_id:f,no_border:1
open a
open c
check
open d
check
open b
check
open e
check
open f
check
dispatch view,2
check
