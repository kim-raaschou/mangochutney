# every matching tag_rule writes open_as_floating, no_render_border and no_hide: a later rule for the tag without them takes them off.
config tag_rule=id:2,no_render_border:1,open_as_floating:1
config tag_rule=id:*,no_hide:1
config tag_rule=id:2,layout_name:scroller
config tag_rule=id:3,no_hide:-1
config tag_rule=id:4,open_as_floating:1
dispatch view,2
open a
check
dispatch view,4
open b
check
dispatch view,3
open c
check
get all-tags
