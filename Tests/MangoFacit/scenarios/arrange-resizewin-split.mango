# resizewin,+50,+0 on a stack window moves the split: the master grows in tile, and shrinks from the master in right_tile.
# ours: tile gives the last window of a column the rest of it (a mango bug, docs/afvigelser.md §6).
config new_is_master=0
open a
open b
open c
open d
check
ours d.height 351
dispatch @c resizewin,+50,+0
check
ours d.height 351
dispatch setlayout,right_tile
check
ours d.height 351
dispatch @a resizewin,+50,+0
check
ours d.height 351
