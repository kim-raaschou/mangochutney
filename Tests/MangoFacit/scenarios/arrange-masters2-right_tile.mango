# right_tile with default_master_count=2 and 1, 2, 3 and 5 windows.
# ours: tile gives the last window of a column the rest of it (a mango bug, docs/afvigelser.md §6).
config default_master_count=2
dispatch setlayout,right_tile
open a
check
open b
check
open c
check
open d
open e
check
ours a.height 351
